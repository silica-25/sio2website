---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import Avatar from '../components/Avatar.astro';
import { site, kakeibo, hobbies } from '../data/site';
import { sortedLog } from '../data/log';
import { getNotes } from '../data/notes';
import { photos } from '../data/photos';

const notes = await getNotes();
---

<BaseLayout>
  <div class="bento">
    <section class="tile hero">
      <p class="label">// personal site</p>
      <div class="hero-row">
        <h1>{site.name}</h1>
        <div class="hero-avatar">
          <Avatar size={120} />
        </div>
      </div>
      <p class="lead">{site.tagline}</p>
    </section>

    <a class="tile kakeibo" href="/kakeibo">
      <p class="label">app / {kakeibo.status}</p>
      <h2>{kakeibo.name}</h2>
      <p class="sub">{kakeibo.summary}</p>
    </a>

    <a class="tile hobbies" href="/hobbies">
      <p class="label">hobbies</p>
      <h2>趣味</h2>
      <p class="sub">{hobbies.map((h) => h.title).join(' / ')}</p>
    </a>

    <section class="tile notes">
      <p class="label">notes <a class="more" href="/notes">all →</a></p>
      {
        notes.length ? (
          <ul>
            {notes.slice(0, 4).map((n) => (
              <li class="note-row">
                {n.thumbnail && (
                  <img class="note-thumb" src={n.thumbnail} alt="" loading="lazy" referrerpolicy="no-referrer" />
                )}
                <div>
                  <span class="date">{n.date}</span>
                  <a class="link" href={n.url} target="_blank" rel="noopener noreferrer">
                    {n.title}
                  </a>
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <p class="sub">まだ記事がありません。</p>
        )
      }
    </section>

    <section class="tile log">
      <p class="label">log</p>
      <ul>
        {
          sortedLog.slice(0, 6).map((l) => (
            <li>
              <span class="date">{l.date}</span>
              <span class="tag">{l.tag}</span>
              {l.text}
            </li>
          ))
        }
      </ul>
    </section>

    <a class="tile photos" href="/photos">
      <p class="label">photos / {photos.length}</p>
      {
        photos.length ? (
          <div class="strip">
            {photos.slice(0, 4).map((p) => (
              <Image src={p.src} alt={p.caption} width={400} height={400} loading="lazy" />
            ))}
          </div>
        ) : (
          <p class="sub">写真を追加すると、ここに並びます。</p>
        )
      }
    </a>
  </div>
</BaseLayout>

<style>
  .bento {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 12px;
  }
  .hero {
    grid-column: span 4;
    grid-row: span 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 260px;
    padding: 28px;
  }
  .hero-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .hero-avatar {
    /* 名前の右側の空きスペースにドンと置く。画面が狭いときは自動で縮む */
    --avatar-size: clamp(64px, 14vw, 120px);
  }
  .hero h1 {
    font-family: var(--mono);
    font-size: clamp(3rem, 10vw, 6rem);
    margin: 0 0 0.5rem;
  }
  .hero .lead {
    margin: 0;
  }
  .kakeibo,
  .hobbies {
    grid-column: span 2;
  }
  .notes,
  .log {
    grid-column: span 3;
  }
  .photos {
    grid-column: span 6;
  }
  .strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }
  .strip img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    display: block;
  }
  .sub {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    padding: 6px 0;
    border-top: 1px solid var(--border);
    font-size: 0.92rem;
  }
  .date {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--muted);
    margin-right: 10px;
  }
  .note-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .note-thumb {
    flex-shrink: 0;
    width: 64px;
    aspect-ratio: 1.91 / 1;
    object-fit: cover;
    border: 1px solid var(--border);
  }
  .more {
    float: right;
  }
  .more:hover {
    color: var(--text);
  }

  @media (max-width: 720px) {
    .bento {
      grid-template-columns: 1fr;
    }
    .hero,
    .kakeibo,
    .hobbies,
    .notes,
    .log,
    .photos {
      grid-column: auto;
      grid-row: auto;
    }
    .strip {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
