---
import BaseLayout from '../layouts/BaseLayout.astro';
import NoteList from '../components/NoteList.astro';
import Feed from '../components/Feed.astro';
import { getNotes } from '../data/notes';
import { buildFeed } from '../data/feed';
import { kakeibo } from '../data/site';

const related = (await getNotes()).filter((n) => n.title.includes(kakeibo.keyword));
const devFeed = await buildFeed('kakeibo');
---

<BaseLayout title="Kakeibo" description={kakeibo.summary}>
  <div class="page-head">
    <p class="label">app / {kakeibo.status}</p>
    <h1>{kakeibo.name}</h1>
    <p class="lead">{kakeibo.summary}</p>
    {
      kakeibo.href && (
        <p>
          <a class="link" href={kakeibo.href} target="_blank" rel="noopener noreferrer">
            リポジトリ / デモを見る ↗
          </a>
        </p>
      )
    }
  </div>

  <h2 class="label">notes</h2>
  <NoteList
    notes={related}
    empty={`Note でタイトルに「${kakeibo.keyword}」を含む記事を公開すると、ここに並びます。`}
  />

  <h2 class="label gap">dev log</h2>
  <Feed items={devFeed} />
</BaseLayout>

<style>
  .gap {
    margin-top: 2.5rem;
  }
</style>
