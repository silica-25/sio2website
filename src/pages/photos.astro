---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { photos } from '../data/photos';
---

<BaseLayout title="Photos" description="撮った写真">
  <div class="page-head">
    <p class="label">photos / {photos.length}</p>
    <h1>Photos</h1>
    <p class="lead">撮った写真を並べています。タップすると大きく表示します。</p>
  </div>

  {
    photos.length ? (
      <div class="gallery">
        {photos.map((p, i) => (
          <button type="button" class="thumb" data-index={i} aria-label={p.caption}>
            <Image
              src={p.src}
              alt={p.caption}
              widths={[400, 800, 1200]}
              sizes="(max-width: 720px) 100vw, 33vw"
              loading="lazy"
            />
          </button>
        ))}
      </div>
    ) : (
      <p class="lead">
        まだ写真がありません。<code>src/assets/photos/</code> に画像を入れると、ここに並びます。
      </p>
    )
  }

  <div class="lightbox" id="lightbox" hidden>
    <button type="button" class="close" id="lightbox-close" aria-label="閉じる">✕</button>
    <button type="button" class="nav prev" id="lightbox-prev" aria-label="前の写真">‹</button>
    <button type="button" class="nav next" id="lightbox-next" aria-label="次の写真">›</button>
    <figure>
      <img id="lightbox-img" alt="" />
      <figcaption id="lightbox-caption" class="bubble"></figcaption>
    </figure>
  </div>
</BaseLayout>

<script define:vars={{ items: photos.map((p) => ({ src: p.src.src, caption: p.caption, date: p.date, comment: p.comment })) }}>
  const lightbox = document.getElementById('lightbox');
  const imgEl = document.getElementById('lightbox-img');
  const captionEl = document.getElementById('lightbox-caption');
  let current = 0;

  const render = () => {
    const item = items[current];
    imgEl.src = item.src;
    imgEl.alt = item.caption;
    captionEl.replaceChildren();
    const main = document.createElement('span');
    main.textContent = item.date ? `${item.date} · ${item.caption}` : item.caption;
    captionEl.appendChild(main);
    if (item.comment) {
      const note = document.createElement('span');
      note.className = 'bubble-comment';
      note.textContent = item.comment;
      captionEl.appendChild(note);
    }
  };

  const open = (i) => {
    if (!items.length) return;
    current = (i + items.length) % items.length;
    render();
    lightbox.hidden = false;
    requestAnimationFrame(() => lightbox.classList.add('open'));
    document.body.style.overflow = 'hidden';
  };

  const close = () => {
    lightbox.classList.remove('open');
    document.body.style.overflow = '';
    setTimeout(() => {
      lightbox.hidden = true;
    }, 150);
  };

  document.querySelectorAll('.thumb').forEach((btn) => {
    btn.addEventListener('click', () => open(Number(btn.dataset.index)));
  });
  document.getElementById('lightbox-close').addEventListener('click', close);
  document.getElementById('lightbox-prev').addEventListener('click', () => open(current - 1));
  document.getElementById('lightbox-next').addEventListener('click', () => open(current + 1));
  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox) close();
  });
  document.addEventListener('keydown', (e) => {
    if (lightbox.hidden) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowRight') open(current + 1);
    if (e.key === 'ArrowLeft') open(current - 1);
  });
</script>

<style>
  .gallery {
    columns: 3 260px;
    column-gap: 12px;
  }
  .thumb {
    display: block;
    width: 100%;
    margin: 0 0 20px;
    padding: 0;
    border: 1px solid var(--border);
    background: none;
    break-inside: avoid;
    cursor: pointer;
    transition:
      border-color 0.15s,
      transform 0.15s ease;
  }
  .thumb img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* スクラップブック風に、少しだけ傾けて並べる */
  .thumb:nth-child(5n + 1) {
    transform: rotate(-1.5deg);
  }
  .thumb:nth-child(5n + 2) {
    transform: rotate(1deg);
  }
  .thumb:nth-child(5n + 3) {
    transform: rotate(-1deg);
  }
  .thumb:nth-child(5n + 4) {
    transform: rotate(1.75deg);
  }
  .thumb:nth-child(5n + 5) {
    transform: rotate(-0.5deg);
  }
  .thumb:hover {
    border-color: var(--strong);
    transform: rotate(0deg) scale(1.03);
    z-index: 1;
    position: relative;
  }

  @media (prefers-reduced-motion: reduce) {
    .thumb {
      transform: none !important;
      transition: none;
    }
  }
  code {
    font-family: var(--mono);
    font-size: 0.85em;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 56px 20px;
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    backdrop-filter: blur(8px);
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  .lightbox[hidden] {
    display: none;
  }
  .lightbox.open {
    opacity: 1;
  }
  .lightbox figure {
    margin: 0;
    max-width: min(92vw, 920px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    transform: translateY(6px) scale(0.98);
    transition: transform 0.15s ease;
  }
  .lightbox.open figure {
    transform: none;
  }
  .lightbox img {
    max-width: 100%;
    max-height: 72vh;
    width: auto;
    display: block;
    border: 1px solid var(--border);
    background: var(--surface);
  }

  /* 吹き出し */
  .bubble {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 3px;
    font-family: var(--mono);
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    line-height: 1.5;
    color: var(--bg);
    background: var(--strong);
    padding: 8px 16px;
    max-width: 100%;
  }
  .bubble:empty {
    display: none;
  }
  .bubble-comment {
    font-size: 0.75rem;
    opacity: 0.75;
  }
  .bubble::before {
    content: '';
    position: absolute;
    top: -8px;
    left: 22px;
    width: 14px;
    height: 8px;
    background: var(--strong);
    clip-path: polygon(0 100%, 100% 100%, 40% 0);
  }

  .close,
  .nav {
    position: absolute;
    background: none;
    border: 1px solid var(--border);
    color: var(--text);
    font-family: var(--mono);
    cursor: pointer;
    width: 40px;
    height: 40px;
  }
  .close:hover,
  .nav:hover {
    border-color: var(--strong);
  }
  .close {
    top: 16px;
    right: 16px;
  }
  .nav {
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.5rem;
  }
  .prev {
    left: 16px;
  }
  .next {
    right: 16px;
  }

  @media (max-width: 720px) {
    .nav {
      display: none;
    }
  }
</style>
