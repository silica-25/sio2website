---
import BaseLayout from '../layouts/BaseLayout.astro';
import Avatar from '../components/Avatar.astro';
import { site, timeline, certifications } from '../data/site';
---

<BaseLayout title="About" description={`${site.name} について`}>
  <div class="page-head">
    <p class="label">about</p>
    <h1>About</h1>
  </div>

  <div class="cols">
    <section class="tile profile">
      <p class="label">profile</p>
      <div class="profile-row">
        <Avatar size={80} />
        <p>{site.bio}</p>
      </div>
    </section>

    <section class="tile">
      <p class="label">timeline</p>
      <ul>
        {
          timeline.map((t) => (
            <li class="row">
              <span class="year">{t.year}</span>
              <span>{t.text}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="tile">
      <p class="label">contact</p>
      <ul>
        <li><a class="link" href={`mailto:${site.email}`}>{site.email}</a></li>
        {
          site.links.map((l) => (
            <li>
              <a class="link" href={l.href} target="_blank" rel="noopener noreferrer">
                {l.label} ↗
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {
      certifications.length > 0 && (
        <section class="tile">
          <p class="label">certifications</p>
          <ul>
            {certifications.map((c) => (
              <li class="row cert">
                <span class="year">{c.date ?? ''}</span>
                <span>{c.name}</span>
                <span class="cert-note" hidden={!c.note}>
                  {c.note}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 12px;
  }
  .profile {
    grid-column: 1 / -1;
  }
  .profile-row {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    flex-wrap: wrap;
  }
  .profile-row p {
    margin: 0;
    flex: 1;
    min-width: 200px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    padding: 6px 0;
    border-top: 1px solid var(--border);
  }
  /* 日付 | 本文 | 補足 の3列に固定して、日付や補足がない行でも本文の開始位置をそろえる */
  .row {
    display: grid;
    grid-template-columns: 4.7rem 1fr;
    column-gap: 12px;
    align-items: baseline;
  }
  .row.cert {
    grid-template-columns: 4.7rem 1fr auto;
  }
  .year {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--muted);
  }
  .cert-note {
    justify-self: end;
    padding: 0 6px;
    border: 1px solid var(--border);
    font-family: var(--mono);
    font-size: 0.68rem;
    line-height: 1.6;
    white-space: nowrap;
    color: var(--muted);
  }
</style>
